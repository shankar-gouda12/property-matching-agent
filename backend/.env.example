# Deployment configuration. Do not commit real passwords or service-account keys.
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheet-id
GOOGLE_SHEETS_WORKSHEET=Sheet1
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
INVENTORY_HEADER_ROW=2
INVENTORY_REFRESH_SECONDS=30
AUTH_USERS=admin@example.com:change-this-password
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=https://your-frontend-domain.com
